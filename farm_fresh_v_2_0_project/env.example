"""Copy this file to env.py and replace placeholder values for local use.

The local development flags come first. The remaining values document the keys
expected by production settings and external integrations.
"""
import os

# Local Django development settings
os.environ["DEVELOPMENT"] = "True"
os.environ["DEBUG"] = "True"
os.environ["SECRET_KEY"] = "replace-with-a-local-django-secret-key"

# Production database settings
os.environ["DATABASE_NAME"] = "replace-production-database-name"
os.environ["DATABASE_USER"] = "replace-production-database-user"
os.environ["DATABASE_PASSWORD"] = "replace-production-database-password"
os.environ["DATABASE_HOST"] = "replace-production-database-host"

# Email settings
os.environ["EMAIL_HOST_USER"] = "replace-email-address"
os.environ["EMAIL_HOST_PASS"] = "replace-email-app-password"

# AWS S3 settings
os.environ["AWS_ACCESS_KEY_ID"] = "replace-aws-access-key-id"
os.environ["AWS_SECRET_ACCESS_KEY"] = "replace-aws-secret-access-key"

# Stripe settings
os.environ["STRIPE_PUBLIC_KEY"] = "replace-stripe-public-key"
os.environ["STRIPE_SECRET_KEY"] = "replace-stripe-secret-key"
os.environ["STRIPE_WH_SECRET"] = "replace-stripe-webhook-secret-from-stripe-cli-for-local-testing"
